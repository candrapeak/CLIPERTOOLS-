# Utama: API resmi DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Cadangan: DeepSeek lewat OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# Opsional: transkrip cloud + fallback highlight terakhir
OPENAI_API_KEY=

# Model Whisper lokal jika OpenAI tidak dipakai
WHISPER_MODEL=base
